# Configurações da API Uazapi (versão 2.6.9+)
# SERVER_URL: O endereço base do servidor onde estão suas instâncias (ex: https://free.uazapi.com ou https://gruposafira.uazapi.com)
SERVER_URL=https://free.uazapi.com

# ADMIN_TOKEN: O token de administração do servidor (admintoken) copiado do painel da Uazapi
ADMIN_TOKEN=seu_admin_token_aqui

# Filtro de instâncias por palavras-chave no nome (separadas por vírgula)
FILTER_KEYWORDS=NIO,BMG

# Palavras-chave para IGNORAR / SILENCIAR instâncias (ex: números marcados como banidos ou em análise)
IGNORE_KEYWORDS=BAN,ANALISE,ANÁLISE,BANIDO,DESCARTE

# Intervalo entre checagens em minutos
CHECK_INTERVAL_MINUTES=20
